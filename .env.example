# Copy this file to .env and fill in your values
# .env is gitignored — it will never be committed to the repo

# api-football.com via RapidAPI
# Get your key at: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=your_rapidapi_key_here

# FIFA World Cup 2026 league ID on api-football
# Default is 1 (FIFA World Cup). If fixtures aren't found, check:
# https://www.api-football.com/documentation-v3#tag/Leagues/operation/get-leagues
WC_LEAGUE_ID=1
WC_SEASON=2026

# Absolute path to your local clone of bdavey619/world-cup-guide
# Used by update-lineup.js to commit and push changes
# Run: git clone https://github.com/bdavey619/world-cup-guide.git ~/world-cup-guide
REPO_PATH=/Users/YOUR_USERNAME/world-cup-guide

# Your machine's UTC offset in hours (EDT = -4, PDT = -7, CDT = -5)
# Used by generate-crontab.js to convert ET kickoff times to your local time
UTC_OFFSET=-4
