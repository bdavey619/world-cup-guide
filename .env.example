# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed to the repo.

# Absolute path to your permanent local clone of bdavey619/world-cup-guide
# Run once: git clone https://github.com/bdavey619/world-cup-guide.git ~/world-cup-guide
REPO_PATH=/Users/YOUR_USERNAME/world-cup-guide

# Your machine's UTC offset in hours (EDT=-4, CDT=-5, MDT=-6, PDT=-7)
# Used by generate-crontab.js to convert ET kickoff times to your local time.
UTC_OFFSET=-4
